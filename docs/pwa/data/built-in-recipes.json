    {"id":"builtin-tomato-egg","name":"西红柿炒鸡蛋","category":"炒菜","cuisine":"家常融合","flavor":"咸鲜微甜","difficulty":"简单","minutes":15,"servings":2,"ingredients":[{"name":"西红柿","amount":"2个","staple":false},{"name":"鸡蛋","amount":"3个","staple":false},{"name":"食用油","amount":"适量","staple":true},{"name":"盐","amount":"适量","staple":true},{"name":"白糖","amount":"1小勺","staple":true}],"steps":["西红柿切块，鸡蛋加少许盐打散。","热锅下油，将鸡蛋炒至凝固后盛出。","原锅炒软西红柿，加盐和白糖调味。","倒回鸡蛋，翻炒均匀即可。"],"tips":"西红柿炒出汤汁后再放鸡蛋，口感更融合。","custom":false},
    {"id":"builtin-potato","name":"酸辣土豆丝","category":"炒菜","cuisine":"川菜","flavor":"酸辣","difficulty":"简单","minutes":20,"servings":2,"ingredients":[{"name":"土豆","amount":"2个","staple":false},{"name":"青椒","amount":"1个","staple":false},{"name":"干辣椒","amount":"3个","staple":false},{"name":"食用油","amount":"适量","staple":true},{"name":"盐","amount":"适量","staple":true},{"name":"醋","amount":"1汤勺","staple":true}],"steps":["土豆切细丝，用清水洗去表面淀粉。","青椒切丝，干辣椒切段。","热锅下油爆香干辣椒，放入土豆丝大火翻炒。","加入青椒、盐和醋，炒至断生。"],"tips":"土豆丝洗净淀粉并大火快炒，成品更爽脆。","custom":false},
    {"id":"builtin-green-pepper-pork","name":"青椒肉丝","category":"炒菜","cuisine":"川菜","flavor":"咸鲜","difficulty":"中等","minutes":25,"servings":2,"ingredients":[{"name":"猪里脊","amount":"200克","staple":false},{"name":"青椒","amount":"2个","staple":false},{"name":"生抽","amount":"1汤勺","staple":true},{"name":"淀粉","amount":"1小勺","staple":true}],"steps":["猪里脊切丝，加生抽和淀粉抓匀腌制10分钟。","青椒去籽切丝。","热锅下油，将肉丝滑炒至变色。","加入青椒大火翻炒，调盐后出锅。"],"tips":"肉丝逆纹切、短时间滑炒，口感更嫩。","custom":false},
    {"id":"builtin-cola-wings","name":"可乐鸡翅","category":"炖煮","cuisine":"家常融合","flavor":"咸甜","difficulty":"简单","minutes":35,"servings":2,"ingredients":[{"name":"鸡翅中","amount":"8个","staple":false},{"name":"可乐","amount":"330毫升","staple":false},{"name":"姜","amount":"3片","staple":false},{"name":"生抽","amount":"2汤勺","staple":true}],"steps":["鸡翅两面划刀，冷水下锅焯去浮沫。","锅中少油，将鸡翅煎至两面微黄。","加入姜片、生抽和可乐，大火煮开。","转中小火焖20分钟，最后大火收汁。"],"tips":"收汁时勤翻动，避免含糖汤汁粘锅。","custom":false},
    {"id":"builtin-mapo-tofu","name":"麻婆豆腐","category":"炒菜","cuisine":"川菜","flavor":"麻辣","difficulty":"中等","minutes":25,"servings":2,"ingredients":[{"name":"嫩豆腐","amount":"1盒","staple":false},{"name":"猪肉末","amount":"100克","staple":false},{"name":"豆瓣酱","amount":"1汤勺","staple":false},{"name":"花椒","amount":"适量","staple":false}],"steps":["豆腐切块，用淡盐水浸泡。","锅中炒香肉末，加入豆瓣酱炒出红油。","加适量清水和豆腐，小火煮8分钟。","淀粉水分两次勾芡，撒花椒粉和葱花。"],"tips":"豆腐下锅后轻推，不要频繁翻动。","custom":false},
    {"id":"builtin-broccoli","name":"蒜蓉西兰花","category":"炒菜","cuisine":"家常融合","flavor":"清香","difficulty":"简单","minutes":15,"servings":2,"ingredients":[{"name":"西兰花","amount":"1棵","staple":false},{"name":"大蒜","amount":"5瓣","staple":false}],"steps":["西兰花切小朵，在淡盐水中浸泡后洗净。","沸水加少许盐和油，将西兰花焯水1分钟。","热锅下油爆香蒜末，放入西兰花快速翻炒。","加盐调味后出锅。"],"tips":"焯水时间不要过长，以保持翠绿和脆嫩。","custom":false},
    {"id":"builtin-kungpao","name":"宫保鸡丁","category":"炒菜","cuisine":"川菜","flavor":"酸甜微辣","difficulty":"中等","minutes":30,"servings":3,"ingredients":[{"name":"鸡胸肉","amount":"250克","staple":false},{"name":"花生米","amount":"50克","staple":false},{"name":"黄瓜","amount":"半根","staple":false},{"name":"干辣椒","amount":"5个","staple":false}],"steps":["鸡胸肉切丁，加生抽和淀粉腌制。","黄瓜切丁，调好糖醋碗汁。","热锅炒香干辣椒和葱段，放鸡丁炒至变色。","加入黄瓜、花生米和碗汁，大火翻匀。"],"tips":"花生米最后放，能保持酥脆。","custom":false},
    {"id":"builtin-egg-fried-rice","name":"家常蛋炒饭","category":"主食","cuisine":"家常融合","flavor":"咸香","difficulty":"简单","minutes":15,"servings":1,"ingredients":[{"name":"米饭","amount":"1碗","staple":false},{"name":"鸡蛋","amount":"2个","staple":false},{"name":"胡萝卜","amount":"半根","staple":false}],"steps":["米饭提前拨散，胡萝卜切小丁。","鸡蛋打散后炒熟盛出。","原锅炒香胡萝卜丁，加入米饭大火翻炒。","加入鸡蛋和葱花，以盐调味。"],"tips":"隔夜冷米饭水分较少，更容易炒得粒粒分明。","custom":false},
    {"id":"builtin-seaweed-soup","name":"紫菜蛋花汤","category":"汤羹","cuisine":"家常融合","flavor":"清鲜","difficulty":"简单","minutes":10,"servings":2,"ingredients":[{"name":"紫菜","amount":"1小把","staple":false},{"name":"鸡蛋","amount":"1个","staple":false}],"steps":["紫菜用清水快速冲洗，鸡蛋打散。","锅中水烧开，放入紫菜。","沿锅边缓慢淋入蛋液，待凝固后轻推。","加盐和香油，撒葱花。"],"tips":"蛋液下锅后先不要搅动，蛋花会更完整。","custom":false},
    {"id":"builtin-mushroom-greens","name":"香菇炒青菜","category":"炒菜","cuisine":"家常融合","flavor":"清鲜","difficulty":"简单","minutes":15,"servings":2,"ingredients":[{"name":"鲜香菇","amount":"6朵","staple":false},{"name":"上海青","amount":"300克","staple":false}],"steps":["香菇切片，上海青洗净沥水。","热锅下油爆香蒜末，先炒香菇。","加入上海青大火翻炒至变软。","加盐调味，快速出锅。"],"tips":"青菜下锅前尽量沥干，避免炒制时出水过多。","custom":false},
    {"id":"builtin-braised-eggplant","name":"家常红烧茄子","category":"炖煮","cuisine":"家常融合","flavor":"咸鲜","difficulty":"中等","minutes":30,"servings":3,"ingredients":[{"name":"茄子","amount":"2根","staple":false},{"name":"青椒","amount":"1个","staple":false},{"name":"大蒜","amount":"4瓣","staple":false}],"steps":["茄子切滚刀块，加少许盐静置后挤去水分。","茄子表面薄裹淀粉，煎至软嫩。","加入蒜末和青椒翻炒。","倒入料汁，收浓即可。"],"tips":"茄子提前用盐腌制，可以减少吸油。","custom":false},
    {"id":"builtin-steamed-fish","name":"清蒸鲈鱼","category":"蒸菜","cuisine":"粤菜","flavor":"鲜香","difficulty":"中等","minutes":25,"servings":3,"ingredients":[{"name":"鲈鱼","amount":"1条","staple":false},{"name":"姜","amount":"5片","staple":false},{"name":"葱","amount":"2根","staple":false}],"steps":["鲈鱼处理干净，在鱼身两侧划刀。","盘底铺姜葱，放鱼后水开上锅蒸8至10分钟。","倒掉盘中腥水，换上新葱丝。","淋蒸鱼豉油，再浇一勺热油。"],"tips":"蒸制时间按鱼的大小调整，关火后可焖2分钟。","custom":false},
    {"id":"builtin-beef-potato","name":"土豆炖牛肉","category":"炖煮","cuisine":"北方菜","flavor":"浓香","difficulty":"中等","minutes":80,"servings":4,"ingredients":[{"name":"牛腩","amount":"500克","staple":false},{"name":"土豆","amount":"2个","staple":false},{"name":"胡萝卜","amount":"1根","staple":false},{"name":"番茄","amount":"1个","staple":false}],"steps":["牛腩切块，冷水下锅焯水。","锅中炒香姜片和番茄，加入牛肉翻炒。","加热水没过食材，小火炖50分钟。","加入土豆和胡萝卜，再炖20分钟并调味。"],"tips":"炖肉时加入热水，肉质不易骤然收紧。","custom":false},
    {"id":"builtin-lettuce","name":"蚝油生菜","category":"炒菜","cuisine":"粤菜","flavor":"咸鲜","difficulty":"简单","minutes":10,"servings":2,"ingredients":[{"name":"生菜","amount":"1棵","staple":false},{"name":"大蒜","amount":"3瓣","staple":false}],"steps":["生菜洗净，大蒜切末。","生菜放入沸水中快速焯至变色，捞出装盘。","锅中少油炒香蒜末，加入蚝油、生抽和少量清水。","将料汁煮开后淋在生菜上。"],"tips":"生菜焯水十几秒即可，时间过长会失去爽脆口感。","custom":false},
    {"id":"builtin-pumpkin-porridge","name":"南瓜小米粥","category":"主食","cuisine":"北方菜","flavor":"清甜","difficulty":"简单","minutes":40,"servings":3,"ingredients":[{"name":"南瓜","amount":"250克","staple":false},{"name":"小米","amount":"100克","staple":false}],"steps":["小米淘洗后浸泡10分钟，南瓜去皮切小块。","锅中水烧开，放入小米并搅拌。","加入南瓜，小火煮30分钟。","期间偶尔搅拌，煮至浓稠。"],"tips":"水开后再下小米，粥更容易香浓。","custom":false}
  ]
